# ── Gratuit recommandé (Google AI Studio) ──
# https://aistudio.google.com/apikey  → Create API key (gratuit, quotas généreux)
OCR_PROVIDER=gemini
GOOGLE_AI_API_KEY=

# ── Alternative gratuite (OCR texte seulement, moins précis) ──
# https://ocr.space/ocrapi  → clé gratuite ~25 000 req/mois
# OCR_PROVIDER=ocrspace
# OCR_SPACE_API_KEY=

# Clé de démo OCR.space (tests seulement, très limitée) :
# OCR_SPACE_API_KEY=helloworld

# ── Payant (optionnel) ──
# OCR_PROVIDER=claude
# CLAUDE_API_KEY=

PORT=3101
POCKETBASE_URL=http://127.0.0.1:8090
REQUIRE_AUTH=true

# Essayer plusieurs providers dans l'ordre si le premier échoue :
# OCR_FALLBACK=gemini,ocrspace
