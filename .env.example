# JobsitePro — root environment overview
# Copy values into each service .env (see services/*/.env.example).
# This file is a checklist only; services do not load it automatically.

# Public URL of the app
PUBLIC_URL=https://jobsitepro.example.com
PATRON_APP_URL=https://jobsitepro.example.com/patron/

# PocketBase
POCKETBASE_URL=http://127.0.0.1:8091
POCKETBASE_ADMIN_TOKEN=Bearer YOUR_POCKETBASE_ADMIN_JWT

# Receipt OCR (Gemini)
GOOGLE_AI_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY
OCR_PROVIDER=gemini

# Contact email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO=contact@example.com
CONTACT_FROM=noreply@example.com

# QuickBooks
QUICKBOOKS_CLIENT_ID=YOUR_QUICKBOOKS_CLIENT_ID
QUICKBOOKS_CLIENT_SECRET=YOUR_QUICKBOOKS_CLIENT_SECRET
QUICKBOOKS_REDIRECT_URI=https://jobsitepro.example.com/api/jobsitepro/oauth/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox

# Integrations hub
INTEGRATIONS_SERVICE_SECRET=change-me-long-random-string
